   "animations": [
    {
     "var.ocelot_swim_active": "if(is_in_water,1,if(is_on_ground,0,var.ocelot_swim_active))",
     "var.ocelot_swim_t": "if(var.ocelot_swim_active>0.5,var.ocelot_swim_t+frame_time,0)",
     "var.ocelot_swim_warm": "clamp(var.ocelot_swim_warm+if(var.ocelot_swim_active>0.5,5,-5)*frame_time,0,1)",
     "var.ocelot_idle_warm": "clamp(var.ocelot_idle_warm+if(limb_speed<0.1,3.333333,-3.333333)*frame_time,0,1)",
     "varb.ocelot_turn_fcc": "frame_counter==var.ocelot_turn_fcp",
     "var.ocelot_turn_raw_yaw": "todeg(rot_y)",
     "var.ocelot_turn_physical_delta": "if(var.ocelot_turn_sampled>0.5,wrapdeg(var.ocelot_turn_raw_yaw-var.ocelot_turn_prev_raw_yaw),0)",
     "var.ocelot_turn_air_t": "if(varb.ocelot_turn_fcc,var.ocelot_turn_air_t,if(!is_on_ground&&!is_in_water,min(var.ocelot_turn_air_t+frame_time,1),0))",
     "var.ocelot_turn_pose_gate": "if(!is_in_water&&(is_on_ground||var.ocelot_turn_air_t<=0.1),1,0)",
     "var.ocelot_turn_locomotion": "if(varb.ocelot_turn_fcc,var.ocelot_turn_locomotion,if(var.ocelot_turn_locomotion>0.5,if(limb_speed>0.015,1,0),if(limb_speed>=0.02,1,0)))",
     "var.ocelot_turn_signal": "if(var.ocelot_turn_pose_gate>0.5&&var.ocelot_turn_locomotion<0.5&&abs(var.ocelot_turn_physical_delta)>=0.000573,1,0)",
     "var.ocelot_turn_cycle_end": "if(var.ocelot_turn_playing>0.5&&var.ocelot_turn_t>=0.5,1,0)",
     "var.ocelot_turn_start": "if(var.ocelot_turn_signal>0.5&&var.ocelot_turn_playing<0.5,1,0)",
     "var.ocelot_turn_amount": "if(varb.ocelot_turn_fcc,var.ocelot_turn_amount,if(var.ocelot_turn_start>0.5||var.ocelot_turn_cycle_end>0.5&&var.ocelot_turn_signal>0.5,if(var.ocelot_turn_physical_delta>0,45,-45),var.ocelot_turn_amount))",
     "var.ocelot_turn_playing": "if(varb.ocelot_turn_fcc,var.ocelot_turn_playing,if(var.ocelot_turn_pose_gate<0.5||var.ocelot_turn_locomotion>0.5,0,if(var.ocelot_turn_start>0.5,1,if(var.ocelot_turn_playing>0.5&&var.ocelot_turn_cycle_end<0.5,1,if(var.ocelot_turn_cycle_end>0.5&&var.ocelot_turn_signal>0.5,1,0)))))",
     "var.ocelot_turn_t": "if(varb.ocelot_turn_fcc,var.ocelot_turn_t,if(var.ocelot_turn_start>0.5,0,if(var.ocelot_turn_cycle_end>0.5&&var.ocelot_turn_signal>0.5,0,if(var.ocelot_turn_playing>0.5,min(var.ocelot_turn_t+frame_time,0.5),if(var.ocelot_turn_warm>0.001,var.ocelot_turn_t,0)))))",
     "var.ocelot_turn_warm": "if(varb.ocelot_turn_fcc,var.ocelot_turn_warm,clamp(var.ocelot_turn_warm+if(var.ocelot_turn_playing>0.5,10,-10)*frame_time,0,1))",
     "var.ocelot_turn_blend": "var.ocelot_turn_warm*var.ocelot_turn_warm*(3-2*var.ocelot_turn_warm)",
     "var.ocelot_turn_phase": "clamp(var.ocelot_turn_t/0.5,0,1)",
     "var.ocelot_turn_prev_raw_yaw": "if(varb.ocelot_turn_fcc,var.ocelot_turn_prev_raw_yaw,var.ocelot_turn_raw_yaw)",
     "var.ocelot_turn_sampled": "if(varb.ocelot_turn_fcc,var.ocelot_turn_sampled,1)",
     "var.ocelot_turn_fcp": "frame_counter",
     "var.ocelot_stay_enabled": "if(is_on_ground&&!is_in_water&&var.ocelot_swim_active<0.5&&var.ocelot_turn_playing<0.5&&var.ocelot_turn_blend<0.001&&var.ocelot_turn_signal<0.5,1,0)",
     "var.ocelot_stay_to_wait": "if(var.ocelot_stay_enabled>0.5&&var.ocelot_stay_state<0.5&&var.ocelot_stay_state_time>5.76,1,0)",
     "var.ocelot_stay_to_play": "if(var.ocelot_stay_enabled>0.5&&var.ocelot_stay_state>0.5&&var.ocelot_stay_state<1.5&&var.ocelot_stay_state_time>var.ocelot_stay_wait,1,0)",
     "var.ocelot_stay_wait_reset": "if(var.ocelot_stay_to_play<0.5&&var.ocelot_stay_state>0.5&&var.ocelot_stay_state<1.5&&limb_speed>0,1,0)",
     "var.ocelot_stay_play_exit": "if(var.ocelot_stay_state>1.5&&(var.ocelot_stay_state_time>=var.ocelot_stay_len||limb_speed>=0.02||var.ocelot_turn_playing>0.5||var.ocelot_turn_signal>0.5||var.ocelot_turn_blend>0.001),1,0)",
     "var.ocelot_stay_disable_reset": "if(var.ocelot_stay_enabled<0.5&&(var.ocelot_stay_state>0.5||var.ocelot_stay_state_time>0)&&var.ocelot_stay_play_exit<0.5,1,0)",
     "var.ocelot_stay_transition": "if(var.ocelot_stay_to_wait>0.5||var.ocelot_stay_to_play>0.5||var.ocelot_stay_wait_reset>0.5||var.ocelot_stay_play_exit>0.5||var.ocelot_stay_disable_reset>0.5,1,0)",
     "var.ocelot_stay_wait_seq": "var.ocelot_stay_wait_seq+var.ocelot_stay_to_wait",
     "var.ocelot_stay_wait": "if(var.ocelot_stay_to_wait>0.5,96+random(id*3253+var.ocelot_stay_wait_seq*7919+104729)*144,var.ocelot_stay_wait)",
     "var.ocelot_stay_play_seq": "var.ocelot_stay_play_seq+var.ocelot_stay_to_play",
     "var.ocelot_stay_pick": "if(var.ocelot_stay_to_play>0.5,random(id*5171+var.ocelot_stay_play_seq*9973),var.ocelot_stay_pick)",
     "var.ocelot_stay_sel": "if(var.ocelot_stay_to_play>0.5,floor(var.ocelot_stay_pick*1.9999),var.ocelot_stay_sel)",
     "var.ocelot_stay_src_len": "if(var.ocelot_stay_sel<0.5,69,135)",
     "var.ocelot_stay_len": "if(var.ocelot_stay_sel<0.5,86.25,168.75)",
