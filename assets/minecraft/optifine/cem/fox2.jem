   "animations": [
    {
     "body.rx": "torad(90)",
     "body.ry": "0",
     "body.rz": "0",
     "body.tx": "0",
     "var.fox_run_fast": "if(is_sprinting||limb_speed>0.8||(var.fox_run_warm>0.5&&limb_speed>0.66),1,0)",
     "var.fox_run_warm": "clamp(var.fox_run_warm+if(var.fox_run_fast>0.5,6.66667,-6.66667)*frame_time,0,1)",
     "var.fox_swim_active": "if(is_in_water,1,if(is_on_ground,0,var.fox_swim_active))",
     "var.fox_swim_t": "if(var.fox_swim_active>0.5,var.fox_swim_t+frame_time,0)",
     "var.fox_swim_warm": "clamp(var.fox_swim_warm+if(var.fox_swim_active>0.5,5,-5)*frame_time,0,1)",
     "varb.fox_sit_fcc": "frame_counter==var.fox_sit_fcp",
     "var.fox_sit_fcp": "frame_counter",
     "var.fox_sit_p": "if(varb.fox_sit_fcc,var.fox_sit_p,clamp(var.fox_sit_p+clamp((if(alt_fox_sitting>0.5,1,0))-var.fox_sit_p,-(if((if(alt_fox_sitting>0.5,1,0))>0.5,1.6,1.11111)*frame_time),(if((if(alt_fox_sitting>0.5,1,0))>0.5,1.6,1.11111)*frame_time)),0,1))",
     "var.fox_sit_dir": "if(varb.fox_sit_fcc,var.fox_sit_dir,clamp(var.fox_sit_dir+clamp((if(alt_fox_sitting>0.5,1,0))-var.fox_sit_dir,-(8.33333*frame_time),(8.33333*frame_time)),0,1))",
     "varb.fox_sleep_fcc": "frame_counter==var.fox_sleep_fcp",
     "var.fox_sleep_fcp": "frame_counter",
     "var.fox_sleep_p": "if(varb.fox_sleep_fcc,var.fox_sleep_p,clamp(var.fox_sleep_p+clamp((if(alt_fox_sleeping>0.5,1,0))-var.fox_sleep_p,-(if((if(alt_fox_sleeping>0.5,1,0))>0.5,1.41177,0.750002)*frame_time),(if((if(alt_fox_sleeping>0.5,1,0))>0.5,1.41177,0.750002)*frame_time)),0,1))",
     "var.fox_sleep_dir": "if(varb.fox_sleep_fcc,var.fox_sleep_dir,clamp(var.fox_sleep_dir+clamp((if(alt_fox_sleeping>0.5,1,0))-var.fox_sleep_dir,-(10*frame_time),(10*frame_time)),0,1))",
     "var.fox_eyes": "if((if(alt_fox_sleeping>0.5,1,0))>0.5&&var.fox_sleep_p>0.4,1,0)",
     "varb.fox_air_fcc": "frame_counter==var.fox_air_fcp",
     "var.fox_air_fcp": "frame_counter",
     "var.fox_air_vy": "if(varb.fox_air_fcc,var.fox_air_vy,(pos_y-var.fox_prev_y)*0.5+var.fox_air_vy*0.5)",
     "var.fox_prev_y": "if(varb.fox_air_fcc,var.fox_prev_y,pos_y)",
     "var.fox_air_up": "if(varb.fox_air_fcc,var.fox_air_up,if(!is_on_ground&&!is_in_water&&var.fox_air_vy>0.1,1,if(is_on_ground||is_in_water||var.fox_air_vy<-0.0075,0,var.fox_air_up)))",
     "var.fox_air_dn": "if(varb.fox_air_fcc,var.fox_air_dn,if(!is_on_ground&&!is_in_water&&var.fox_air_vy<-0.025,1,if(is_on_ground||is_in_water||var.fox_air_vy>=-0.0075,0,var.fox_air_dn)))",
     "var.fox_jump_warm": "if(varb.fox_air_fcc,var.fox_jump_warm,clamp(var.fox_jump_warm+if(var.fox_air_up>0.5,3.33333,-3.33333)*frame_time,0,1))",
     "var.fox_fall_warm": "if(varb.fox_air_fcc,var.fox_fall_warm,clamp(var.fox_fall_warm+if(var.fox_air_dn>0.5,4.54545,-4.54545)*frame_time,0,1))",
     "var.fox_jump_t": "if(varb.fox_air_fcc,var.fox_jump_t,if(var.fox_air_up>0.5,var.fox_jump_t+frame_time,if(var.fox_jump_warm<0.01,0,var.fox_jump_t)))",
     "var.fox_fall_t": "if(varb.fox_air_fcc,var.fox_fall_t,if(var.fox_air_dn>0.5,var.fox_fall_t+frame_time,if(var.fox_fall_warm<0.01,0,var.fox_fall_t)))",
     "var.fox_jump_f": "clamp(var.fox_jump_t*1.30429,0,1)*18",
     "var.fox_fall_f": "clamp(var.fox_fall_t*1,0,1)*24",
     "varb.fox_stalk_fcc": "frame_counter==var.fox_stalk_fcp",
     "var.fox_stalk_fcp": "frame_counter",
     "var.fox_stalk_p": "if(varb.fox_stalk_fcc,var.fox_stalk_p,clamp(var.fox_stalk_p+clamp((if(alt_fox_stalking>0.5,1,0))-var.fox_stalk_p,-(if((if(alt_fox_stalking>0.5,1,0))>0.5,3.33333,4)*frame_time),(if((if(alt_fox_stalking>0.5,1,0))>0.5,3.33333,4)*frame_time)),0,1))",
     "var.fox_pounce_on": "if(varb.fox_stalk_fcc,var.fox_pounce_on,if(is_on_ground,0,if(var.fox_stalk_p>0.5&&var.fox_air_vy>0.05,1,var.fox_pounce_on)))",
     "var.fox_pounce_warm": "if(varb.fox_stalk_fcc,var.fox_pounce_warm,clamp(var.fox_pounce_warm+if(var.fox_pounce_on>0.5,6.66667,-6.66667)*frame_time,0,1))",
     "var.fox_pounce_t": "if(varb.fox_stalk_fcc,var.fox_pounce_t,if(var.fox_pounce_on>0.5,var.fox_pounce_t+frame_time,if(var.fox_pounce_warm<0.01,0,var.fox_pounce_t)))",
     "varb.fox_turn_fcc": "frame_counter==var.fox_turn_fcp",
     "var.fox_turn_raw_yaw": "todeg(rot_y)",
     "var.fox_turn_raw_delta": "if(var.fox_turn_sampled>0.5,wrapdeg(var.fox_turn_raw_yaw-var.fox_turn_anchor_yaw),0)",
     "var.fox_turn_delta": "clamp(var.fox_turn_raw_delta,-45,45)",
     "var.fox_turn_pose_gate": "if(is_on_ground,1,0)*clamp(1-limb_speed*4,0,1)*(1-clamp(var.fox_sit_p+var.fox_sleep_p+var.fox_stalk_p+var.fox_swim_warm,0,1))",
     "var.fox_turn_pending": "if(var.fox_turn_pose_gate>0.5&&var.fox_turn_active<0.5&&abs(var.fox_turn_delta)>1.5,1,0)",
     "var.fox_turn_lead_t": "if(varb.fox_turn_fcc,var.fox_turn_lead_t,if(var.fox_turn_pending>0.5,var.fox_turn_lead_t+frame_time,0))",
