   "animations": [
    {
     "varb.wolf_turn_fcc": "frame_counter==var.wolf_turn_fcp",
     "var.wolf_turn_raw_yaw": "todeg(rot_y)",
     "var.wolf_turn_raw_delta": "if(var.wolf_turn_sampled>0.5,wrapdeg(var.wolf_turn_raw_yaw-var.wolf_turn_anchor_yaw),0)",
     "var.wolf_turn_delta": "clamp(var.wolf_turn_raw_delta,-45.000,45.000)",
     "var.wolf_turn_pose_gate": "if(is_on_ground,1,0)*(1-var.sit_p)*(1-var.rest_p)*(1-var.sleep_p)*(1-var.swim_warm)*(1-var.shake_warm)",
     "var.wolf_turn_weight": "clamp(1.1-limb_speed,0.01,1)",
     "var.wolf_turn_body_lock": "clamp(1-limb_speed*4,0,1)",
     "var.wolf_turn_pending": "if(var.wolf_turn_pose_gate>0.5&&var.wolf_turn_active<0.5&&abs(var.wolf_turn_delta)>1.5,1,0)",
     "var.wolf_turn_lead_t": "if(varb.wolf_turn_fcc,var.wolf_turn_lead_t,if(var.wolf_turn_pending>0.5,var.wolf_turn_lead_t+frame_time,0))",
     "var.wolf_turn_start": "if(varb.wolf_turn_fcc,0,if(var.wolf_turn_pending>0.5&&(var.wolf_turn_lead_t>=0.12||abs(var.wolf_turn_delta)>=18),1,0))",
     "var.wolf_turn_cycle_end": "if(varb.wolf_turn_fcc,0,if(var.wolf_turn_active>0.5&&var.wolf_turn_t>=9.999,1,0))",
     "var.wolf_turn_next_amount": "clamp(wrapdeg(var.wolf_turn_raw_yaw-(var.wolf_turn_anchor_yaw+var.wolf_turn_amount)),-45.000,45.000)",
     "var.wolf_turn_repeat_needed": "if(var.wolf_turn_active>0.5&&abs(wrapdeg(var.wolf_turn_raw_yaw-(var.wolf_turn_anchor_yaw+var.wolf_turn_amount)))>0.500,1,0)",
     "var.wolf_turn_repeat": "if(var.wolf_turn_cycle_end>0.5&&var.wolf_turn_repeat_needed>0.5&&var.wolf_turn_pose_gate>0.5,1,0)",
     "var.wolf_turn_done": "if(var.wolf_turn_cycle_end>0.5&&var.wolf_turn_repeat<0.5&&var.wolf_turn_pose_gate>0.5,1,0)",
     "var.wolf_turn_anchor_yaw": "if(varb.wolf_turn_fcc,var.wolf_turn_anchor_yaw,if(var.wolf_turn_sampled<0.5,var.wolf_turn_raw_yaw,if(var.wolf_turn_pose_gate<0.5,if(var.wolf_pose_hold>0.001,var.wolf_pose_anchor_yaw,var.wolf_turn_raw_yaw),if(var.wolf_turn_cycle_end>0.5,var.wolf_turn_anchor_yaw+var.wolf_turn_amount,if(var.wolf_turn_active<0.5&&var.wolf_turn_pending<0.5,var.wolf_turn_raw_yaw,var.wolf_turn_anchor_yaw)))))",
     "var.wolf_turn_t": "if(varb.wolf_turn_fcc,var.wolf_turn_t,if(var.wolf_turn_pose_gate<0.5,0,if(var.wolf_turn_start>0.5||var.wolf_turn_cycle_end>0.5,0,if(var.wolf_turn_active>0.5,min(var.wolf_turn_t+frame_time*20,10.000),0))))",
     "var.wolf_turn_active": "if(varb.wolf_turn_fcc,var.wolf_turn_active,if(var.wolf_turn_pose_gate<0.5,0,if(var.wolf_turn_start>0.5,1,if(var.wolf_turn_cycle_end>0.5,var.wolf_turn_repeat,var.wolf_turn_active))))",
     "var.wolf_turn_amount": "if(varb.wolf_turn_fcc,var.wolf_turn_amount,if(var.wolf_turn_start>0.5,var.wolf_turn_delta,if(var.wolf_turn_repeat>0.5,var.wolf_turn_next_amount,var.wolf_turn_amount)))",
     "var.wolf_turn_ease": "clamp(var.wolf_turn_t/10.000,0,1)*clamp(var.wolf_turn_t/10.000,0,1)*(3-2*clamp(var.wolf_turn_t/10.000,0,1))",
     "var.wolf_turn_seam_u": "clamp((var.wolf_turn_t-8.000)/2.000,0,1)",
     "var.wolf_turn_seam": "var.wolf_turn_seam_u*var.wolf_turn_seam_u*(3-2*var.wolf_turn_seam_u)",
     "var.wolf_turn_body_offset": "var.wolf_turn_pose_gate*var.wolf_turn_body_lock*if(var.wolf_turn_active>0.5,wrapdeg(var.wolf_turn_anchor_yaw+var.wolf_turn_amount*var.wolf_turn_ease-var.wolf_turn_raw_yaw),if(var.wolf_turn_pending>0.5,-var.wolf_turn_raw_delta,0))",
     "var.wolf_turn_warm": "clamp(var.wolf_turn_warm+if(var.wolf_turn_active>0.5,10,-10)*frame_time,0,1)",
     "var.wolf_turn_cooldown": "if(varb.wolf_turn_fcc,var.wolf_turn_cooldown,if(var.wolf_turn_done>0.5,0.750,if(var.wolf_turn_active>0.5||var.wolf_turn_pending>0.5,0,max(var.wolf_turn_cooldown-frame_time,0))))",
     "var.wolf_turn_gate": "var.wolf_turn_active*var.wolf_turn_pose_gate*var.wolf_turn_weight*var.wolf_turn_warm",
     "var.wolf_turn_sampled": "if(varb.wolf_turn_fcc,var.wolf_turn_sampled,1)",
     "var.wolf_turn_fcp": "frame_counter",
     "var.dist": "clamp(sqrt(pow(pos_x-player_pos_x,2)+pow(pos_y-player_pos_y,2)+pow(pos_z-player_pos_z,2)),0,128)",
     "var.player_near": "if(var.player_near>0.5,if(var.dist<11.0,1,0),if(var.dist<8.0,1,0))",
     "var.near_enter": "if(var.player_near>0.5&&var.near_prev<0.5,1,0)",
     "var.near_exit": "if(var.player_near<0.5&&(var.near_prev>0.5||var.near_sampled<0.5),1,0)",
     "var.player_close_wake": "if(var.player_close_wake>0.5,if(var.dist<3.5,1,0),if(var.dist<3.0,1,0))",
     "var.close_wake_enter": "if(var.player_close_wake>0.5&&var.player_close_wake_prev<0.5,1,0)",
     "var.mod_return_seq": "alt_wolf_return_seq",
     "var.return_event": "if(var.mod_return_seq>0.5&&var.mod_return_seq!=var.mod_return_seen&&is_tamed&&is_sitting&&var.greet_pending<0.5&&var.greet_active<0.5,1,0)",
     "var.greet_dbg_body_seq": "if(var.return_event>0.5,var.mod_return_seq,var.greet_dbg_body_seq)",
     "var.greet_dbg_collar_seq": "var.greet_dbg_collar_seq",
     "var.greet_dbg_layer": "1",
     "var.greet_dbg_body_passes": "var.greet_dbg_body_passes+1",
     "var.greet_dbg_collar_passes": "var.greet_dbg_collar_passes",
     "var.greet_dbg_near_at_event": "if(var.return_event>0.5,if(alt_wolf_greet_near>0.5,2,1),var.greet_dbg_near_at_event)",
     "var.greet_dbg_local_near_at_event": "if(var.return_event>0.5,if(var.player_near>0.5,2,1),var.greet_dbg_local_near_at_event)",
     "var.greet_dbg_mod_near": "alt_wolf_greet_near",
     "var.near_sampled": "1",
     "var.near_prev": "var.player_near",
     "var.player_close_wake_prev": "var.player_close_wake",
     "var.player_speed": "if(var.player_sampled>0.5,sqrt(pow(player_pos_x-var.player_prev_x,2)+pow(player_pos_y-var.player_prev_y,2)+pow(player_pos_z-var.player_prev_z,2))/max(frame_time,0.001),0)",
     "var.player_move_raw": "if(var.player_speed>0.030,1,0)",
     "var.player_move_grace": "if(var.player_move_raw>0.5,1.25,max(0,var.player_move_grace-frame_time))",
     "var.player_moving": "if(var.player_move_grace>0.001,1,0)",
     "var.player_move_enter": "if(var.player_moving>0.5&&var.player_moving_prev<0.5,1,0)",
     "var.player_moving_prev": "var.player_moving",
     "var.player_prev_x": "player_pos_x",
     "var.player_prev_y": "player_pos_y",
     "var.player_prev_z": "player_pos_z",
     "var.player_sampled": "1",
