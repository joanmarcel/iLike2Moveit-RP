   "animations": [
    {
     "varb.cow_same_frame": "frame_counter==var.cow_frame_prev",
     "var.cow_move": "if(is_on_ground&&!is_in_water&&!is_riding&&!is_ridden&&limb_speed>0.01,1,0)",
     "var.cow_move_warm": "if(varb.cow_same_frame,var.cow_move_warm,clamp(var.cow_move_warm+if(var.cow_move>0.5,8.333333,-8.333333)*frame_time,0,1))",
     "var.cow_move_blend": "var.cow_move_warm*var.cow_move_warm*(3-2*var.cow_move_warm)",
     "var.cow_move_gate": "clamp(limb_speed*3,0,1)*var.cow_move_blend*(1-var.cow_air_pose_blend)*(1-var.cow_swim_blend)",
     "var.cow_gait_phase": "frac(limb_swing*0.106029*1)",
     "var.cow_run_request": "if(var.cow_move>0.5&&limb_speed>0.8,1,0)",
     "var.cow_run_exit_request": "if(var.cow_run_fast>0.5&&limb_speed<0.6,1,0)",
     "var.cow_run_exit_start": "if(var.cow_run_exit_request>0.5&&var.cow_run_exit_pending<0.5,1,0)",
     "var.cow_run_cycle_end": "if(var.cow_run_exit_pending>0.5&&(var.cow_gait_phase<var.cow_run_phase_prev||var.cow_run_exit_t>=0.6),1,0)",
     "var.cow_run_exit_t": "if(varb.cow_same_frame,var.cow_run_exit_t,if(var.cow_run_request>0.5||var.cow_run_cycle_end>0.5,0,if(var.cow_run_exit_start>0.5,0,if(var.cow_run_exit_pending>0.5,var.cow_run_exit_t+frame_time,0))))",
     "var.cow_run_exit_pending": "if(varb.cow_same_frame,var.cow_run_exit_pending,if(var.cow_run_request>0.5||var.cow_run_cycle_end>0.5,0,if(var.cow_run_exit_start>0.5,1,var.cow_run_exit_pending)))",
     "var.cow_run_fast": "if(varb.cow_same_frame,var.cow_run_fast,if(var.cow_run_request>0.5,1,if(var.cow_run_cycle_end>0.5,0,var.cow_run_fast)))",
     "var.cow_run_warm": "if(varb.cow_same_frame,var.cow_run_warm,clamp(var.cow_run_warm+if(var.cow_run_fast>0.5,8.333333,-8.333333)*frame_time,0,1))",
     "var.cow_run_blend": "var.cow_run_warm*var.cow_run_warm*(3-2*var.cow_run_warm)",
     "var.cow_idle_warm": "if(varb.cow_same_frame,var.cow_idle_warm,clamp(var.cow_idle_warm+if(var.cow_move<0.5&&!is_in_water&&!is_riding&&!is_ridden,8.333333,-8.333333)*frame_time,0,1))",
     "var.cow_run_phase_prev": "if(varb.cow_same_frame,var.cow_run_phase_prev,var.cow_gait_phase)",
     "var.cow_swim_active": "if(varb.cow_same_frame,var.cow_swim_active,if(is_in_water,1,if(is_on_ground,0,var.cow_swim_active)))",
     "var.cow_swim_t": "if(varb.cow_same_frame,var.cow_swim_t,if(var.cow_swim_active>0.5,var.cow_swim_t+frame_time,0))",
     "var.cow_swim_warm": "if(varb.cow_same_frame,var.cow_swim_warm,clamp(var.cow_swim_warm+if(var.cow_swim_active>0.5,4.166667,-4.166667)*frame_time,0,1))",
     "var.cow_swim_blend": "var.cow_swim_warm*var.cow_swim_warm*(3-2*var.cow_swim_warm)",
     "var.cow_vy": "if(varb.cow_same_frame,var.cow_vy,(pos_y-var.cow_prev_y)*0.5+var.cow_vy*0.5)",
