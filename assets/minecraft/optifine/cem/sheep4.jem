   "animations": [
    {
     "varb.sheep_same_frame": "frame_counter==var.sheep_frame_prev",
     "var.sheep_move": "if(is_on_ground&&!is_in_water&&!is_riding&&!is_ridden&&limb_speed>0.01,1,0)",
     "var.sheep_move_warm": "if(varb.sheep_same_frame,var.sheep_move_warm,clamp(var.sheep_move_warm+if(var.sheep_move>0.5,8.333333,-8.333333)*frame_time,0,1))",
     "var.sheep_move_blend": "var.sheep_move_warm*var.sheep_move_warm*(3-2*var.sheep_move_warm)",
     "var.sheep_move_gate": "clamp(limb_speed*3,0,1)*var.sheep_move_blend*(1-var.sheep_air_pose_blend)*(1-var.sheep_swim_blend)",
     "var.sheep_gait_phase": "frac(limb_swing*0.106029*1)",
     "var.sheep_run_request": "if(var.sheep_move>0.5&&limb_speed>0.6,1,0)",
     "var.sheep_run_exit_request": "if(var.sheep_run_fast>0.5&&limb_speed<0.3,1,0)",
     "var.sheep_run_start": "if(varb.sheep_same_frame,0,if(var.sheep_run_request>0.5&&var.sheep_run_fast<0.5,1,0))",
     "var.sheep_run_cycle_end": "if(varb.sheep_same_frame,0,if(var.sheep_run_fast>0.5&&var.sheep_run_t>=0.4444,1,0))",
     "var.sheep_run_finish": "if(varb.sheep_same_frame,0,if(var.sheep_run_exit_pending>0.5&&var.sheep_run_cycle_end>0.5,1,0))",
     "var.sheep_run_exit_pending": "if(varb.sheep_same_frame,var.sheep_run_exit_pending,if(var.sheep_move<0.5||var.sheep_run_start>0.5||var.sheep_run_cycle_end>0.5,0,if(var.sheep_run_exit_request>0.5,1,var.sheep_run_exit_pending)))",
     "var.sheep_run_fast": "if(varb.sheep_same_frame,var.sheep_run_fast,if(var.sheep_move<0.5,0,if(var.sheep_run_request>0.5,1,if(var.sheep_run_finish>0.5,0,var.sheep_run_fast))))",
     "var.sheep_run_t": "if(varb.sheep_same_frame,var.sheep_run_t,if(var.sheep_run_fast<0.5,0,if(var.sheep_run_start>0.5||var.sheep_run_cycle_end>0.5,0,min(var.sheep_run_t+frame_time,0.4444))))",
     "var.sheep_run_warm": "if(varb.sheep_same_frame,var.sheep_run_warm,clamp(var.sheep_run_warm+if(var.sheep_run_fast>0.5,8.333333,-5.555556)*frame_time,0,1))",
     "var.sheep_run_blend": "var.sheep_run_warm*var.sheep_run_warm*(3-2*var.sheep_run_warm)",
     "var.sheep_graze_allowed": "if(!is_riding,1,0)",
     "var.sheep_graze_raw": "if(var.sheep_graze_allowed>0.5&&abs(head.ty)>6.05,1,0)",
     "var.sheep_graze_start": "if(varb.sheep_same_frame,0,if(var.sheep_graze_raw>0.5&&var.sheep_graze_prev<0.5,1,0))",
     "var.sheep_graze_active": "if(varb.sheep_same_frame,var.sheep_graze_active,if(var.sheep_graze_allowed<0.5,0,if(var.sheep_graze_start>0.5,1,if(var.sheep_graze_active>0.5&&var.sheep_graze_t<2.35,1,0))))",
     "var.sheep_graze_t": "if(varb.sheep_same_frame,var.sheep_graze_t,if(var.sheep_graze_start>0.5,0,if(var.sheep_graze_active>0.5,min(var.sheep_graze_t+frame_time,2.35),var.sheep_graze_t)))",
     "var.sheep_graze_raw_yaw": "todeg(rot_y)",
     "var.sheep_graze_anchor_yaw": "if(varb.sheep_same_frame,var.sheep_graze_anchor_yaw,if(var.sheep_graze_yaw_sampled<0.5,var.sheep_graze_raw_yaw,if(var.sheep_graze_active<0.5,var.sheep_graze_raw_yaw,var.sheep_graze_anchor_yaw)))",
     "var.sheep_graze_yaw_offset": "wrapdeg(var.sheep_graze_anchor_yaw-var.sheep_graze_raw_yaw)*var.sheep_graze_active",
     "var.sheep_graze_yaw_sampled": "if(varb.sheep_same_frame,var.sheep_graze_yaw_sampled,1)",
     "var.sheep_graze_prev": "if(varb.sheep_same_frame,var.sheep_graze_prev,var.sheep_graze_raw)",
     "var.sheep_air_vy": "if(varb.sheep_same_frame,var.sheep_air_vy,if(var.sheep_env_sampled<0.5,0,(pos_y-var.sheep_air_prev_y)*0.5+var.sheep_air_vy*0.5))",
     "var.sheep_air_prev_y": "if(varb.sheep_same_frame,var.sheep_air_prev_y,pos_y)",
     "var.sheep_airborne": "if(!is_on_ground&&!is_in_water&&!is_riding&&!is_ridden,1,0)",
     "var.sheep_step_edge": "if(var.sheep_env_sampled>0.5&&pos_y-var.sheep_env_anchor_y>=0.02&&var.sheep_step_seen<0.5&&var.sheep_step_active<0.5&&var.sheep_jump_warm<0.001&&!is_in_water&&!is_riding&&!is_ridden,1,0)",
     "var.sheep_step_seen": "if(varb.sheep_same_frame,var.sheep_step_seen,if(var.sheep_step_edge>0.5,1,if(pos_y-var.sheep_env_anchor_y<0.02,0,var.sheep_step_seen)))",
     "var.sheep_step_active": "if(varb.sheep_same_frame,var.sheep_step_active,if(var.sheep_step_edge>0.5,1,if(var.sheep_step_active>0.5&&var.sheep_step_t<0.174,1,0)))",
     "var.sheep_step_t": "if(varb.sheep_same_frame,var.sheep_step_t,if(var.sheep_step_edge>0.5,0,if(var.sheep_step_active>0.5,min(var.sheep_step_t+frame_time,0.224),0)))",
     "var.sheep_jump": "if(varb.sheep_same_frame,var.sheep_jump,if((var.sheep_airborne>0.5&&var.sheep_air_vy>0.1)||var.sheep_step_edge>0.5,1,if(is_in_water||is_riding||is_ridden||(is_on_ground&&var.sheep_step_active<0.5)||(var.sheep_air_vy<-0.0075&&var.sheep_jump_t>0.174),0,var.sheep_jump)))",
     "var.sheep_fall": "if(varb.sheep_same_frame,var.sheep_fall,if(var.sheep_airborne>0.5&&var.sheep_air_vy<-0.025,1,if(is_in_water||is_riding||is_ridden||var.sheep_air_vy>=-0.0075||(is_on_ground&&var.sheep_air_vy>-0.1&&var.sheep_land_rearmed>0.5),0,var.sheep_fall)))",
     "var.sheep_jump_warm": "if(varb.sheep_same_frame,var.sheep_jump_warm,clamp(var.sheep_jump_warm+if(var.sheep_jump>0.5,3.333333,-3.333333)*frame_time,0,1))",
     "var.sheep_fall_warm": "if(varb.sheep_same_frame,var.sheep_fall_warm,clamp(var.sheep_fall_warm+if(var.sheep_fall>0.5,4.545455,-4.545455)*frame_time,0,1))",
     "var.sheep_jump_blend": "var.sheep_jump_warm*var.sheep_jump_warm*(3-2*var.sheep_jump_warm)",
     "var.sheep_fall_blend": "var.sheep_fall_warm*var.sheep_fall_warm*(3-2*var.sheep_fall_warm)",
     "var.sheep_air_pose_blend": "max(var.sheep_jump_blend,var.sheep_fall_blend)",
     "var.sheep_jump_t": "if(varb.sheep_same_frame,var.sheep_jump_t,if(var.sheep_jump>0.5,min(var.sheep_jump_t+frame_time,0.7667),if(var.sheep_jump_warm<0.001,0,var.sheep_jump_t)))",
     "var.sheep_fall_t": "if(varb.sheep_same_frame,var.sheep_fall_t,if(var.sheep_fall>0.5,min(var.sheep_fall_t+frame_time,1),if(var.sheep_fall_warm<0.001,0,var.sheep_fall_t)))",
     "var.sheep_env_anchor_y": "if(varb.sheep_same_frame,var.sheep_env_anchor_y,if(var.sheep_env_sampled<0.5,pos_y,if(is_on_ground&&var.sheep_step_active<0.5&&var.sheep_jump_warm<0.001,pos_y,var.sheep_env_anchor_y)))",
     "var.sheep_env_sampled": "1",
     "var.sheep_bounce_allowed": "if(!is_in_water&&!is_riding&&!is_ridden,1,0)",
     "var.sheep_bounce_anchor_y": "if(varb.sheep_same_frame,var.sheep_bounce_anchor_y,if(var.sheep_bounce_sampled<0.5,pos_y,if(var.sheep_bounce_confirm>0.5,pos_y,if(var.sheep_bounce_armed<0.5&&is_on_ground&&pos_y>=var.sheep_bounce_anchor_y-0.02,pos_y,var.sheep_bounce_anchor_y))))",
     "var.sheep_bounce_drop_now": "max(0,var.sheep_bounce_anchor_y-pos_y)",
     "var.sheep_bounce_descent": "if(var.sheep_bounce_allowed>0.5&&var.sheep_bounce_drop_now>0.02,1,0)",
