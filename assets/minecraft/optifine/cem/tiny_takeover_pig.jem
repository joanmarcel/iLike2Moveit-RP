   "animations": [
    {
     "varb.pig_same_frame": "frame_counter==var.pig_frame",
     "var.pig_frame": "frame_counter",
     "var.pig_server_bridge": "if(alt_server_bridge_present>0.5,1,0)",
     "var.pig_rest": "if(var.pig_server_bridge>0.5,clamp(floor(alt_pig_rest_state+0.01),0,3),0)",
     "var.pig_rest_t": "if(var.pig_server_bridge>0.5,max(alt_pig_rest_age,0),0)",
     "var.pig_rest_active": "if(var.pig_rest>0.5,1,0)",
     "var.pig_rest_warm": "clamp(var.pig_rest_warm+if(var.pig_rest_active>0.5,5.555556,-5.555556)*frame_time,0,1)",
     "var.pig_rest_blend": "var.pig_rest_warm*var.pig_rest_warm*(3-2*var.pig_rest_warm)",
     "var.pig_stand_active": "if(var.pig_rest==3,1,0)",
     "var.pig_stand_warm": "clamp(var.pig_stand_warm+if(var.pig_stand_active>0.5,5.555556,-5.555556)*frame_time,0,1)",
     "var.pig_stand_blend": "var.pig_stand_warm*var.pig_stand_warm*(3-2*var.pig_stand_warm)",
     "var.pig_lie_epoch": "floor(var.pig_rest_t/18)",
     "var.pig_lie_epoch_t": "var.pig_rest_t-var.pig_lie_epoch*18",
     "var.pig_lie_eat_start": "7+random(id+var.pig_lie_epoch)*6",
     "var.pig_lie_eat": "if(var.pig_rest==2&&var.pig_lie_epoch_t>=var.pig_lie_eat_start&&var.pig_lie_epoch_t<var.pig_lie_eat_start+5,1,0)",
     "var.pig_lie_eat_source_t": "max(var.pig_lie_epoch_t-var.pig_lie_eat_start,0)",
     "var.pig_lie_eat_t": "if(varb.pig_same_frame,var.pig_lie_eat_t,if(var.pig_lie_eat>0.5,var.pig_lie_eat_source_t,if(var.pig_lie_eat_warm>0.001,var.pig_lie_eat_t,0)))",
     "var.pig_lie_eat_warm": "clamp(var.pig_lie_eat_warm+if(var.pig_lie_eat>0.5,4.166667,-4.166667)*frame_time,0,1)",
     "var.pig_lie_eat_blend": "var.pig_lie_eat_warm*var.pig_lie_eat_warm*(3-2*var.pig_lie_eat_warm)",
     "var.pig_vy": "if(varb.pig_same_frame,var.pig_vy,(pos_y-var.pig_prev_y)*0.5+var.pig_vy*0.5)",
     "var.pig_prev_y": "if(varb.pig_same_frame,var.pig_prev_y,pos_y)",
     "var.pig_swim": "if(is_in_water,1,if(is_on_ground,0,var.pig_swim))",
     "var.pig_swim_warm": "clamp(var.pig_swim_warm+if(var.pig_swim>0.5,4.166667,-4.166667)*frame_time,0,1)",
     "var.pig_move": "if(is_on_ground&&var.pig_swim_warm<0.999&&limb_speed>0.01&&!is_riding&&var.pig_rest<0.5,1,0)",
     "var.pig_move_warm": "clamp(var.pig_move_warm+if(var.pig_move>0.5,8.333333,-8.333333)*frame_time,0,1)",
     "var.pig_move_blend": "var.pig_move_warm*var.pig_move_warm*(3-2*var.pig_move_warm)",
     "var.pig_move_gate": "var.pig_move_blend*clamp(limb_speed*3,0,1)",
     "var.pig_turn_locomotion": "if(var.pig_turn_locomotion>0.5,if(limb_speed>0.08,1,0),if(limb_speed>=0.1,1,0))",
     "var.pig_turn_locomotion_warm": "clamp(var.pig_turn_locomotion_warm+if(var.pig_turn_locomotion>0.5,8.333333,-8.333333)*frame_time,0,1)",
     "var.pig_turn_locomotion_blend": "var.pig_turn_locomotion_warm*var.pig_turn_locomotion_warm*(3-2*var.pig_turn_locomotion_warm)",
     "var.pig_gait_phase": "frac(limb_swing*0.106029)",
     "var.pig_run_cycle_end": "if(var.pig_gait_phase<var.pig_gait_phase_prev,1,0)",
     "var.pig_run_fast": "if(is_sprinting||limb_speed>0.8||(var.pig_run>0.5&&limb_speed>0.6),1,0)",
     "var.pig_run": "if(var.pig_move<0.5,0,if(var.pig_run>0.5,if(var.pig_run_fast<0.5&&var.pig_run_cycle_end>0.5,0,1),if(var.pig_run_fast>0.5,1,0)))",
     "var.pig_run_warm": "clamp(var.pig_run_warm+if(var.pig_run>0.5,8.333333,-8.333333)*frame_time,0,1)",
     "var.pig_run_blend": "var.pig_run_warm*var.pig_run_warm*(3-2*var.pig_run_warm)",
     "var.pig_gait_phase_prev": "var.pig_gait_phase",
     "var.pig_step_up_edge": "if(var.pig_env_anchor_sampled>0.5&&pos_y-var.pig_env_anchor_y>=0.02&&var.pig_step_up_seen<0.5&&var.pig_step_up_active<0.5&&var.pig_jump_warm<0.001&&!is_in_water&&!is_riding&&var.pig_rest<0.5,1,0)",
     "var.pig_step_up_seen": "if(varb.pig_same_frame,var.pig_step_up_seen,if(var.pig_step_up_edge>0.5,1,if(pos_y-var.pig_env_anchor_y<0.02,0,var.pig_step_up_seen)))",
     "var.pig_step_up_active": "if(varb.pig_same_frame,var.pig_step_up_active,if(var.pig_step_up_edge>0.5,1,if(var.pig_step_up_active>0.5&&var.pig_step_up_t<0.174,1,0)))",
     "var.pig_step_up_t": "if(varb.pig_same_frame,var.pig_step_up_t,if(var.pig_step_up_edge>0.5,0,if(var.pig_step_up_active>0.5,min(var.pig_step_up_t+frame_time,0.224),0)))",
     "var.pig_air": "if(!is_on_ground&&!is_in_water&&var.pig_swim_warm<0.001,1,0)",
     "var.pig_jump": "if(varb.pig_same_frame,var.pig_jump,if((var.pig_air>0.5&&var.pig_vy>0.1)||var.pig_step_up_edge>0.5,1,if(is_in_water||(is_on_ground&&var.pig_step_up_active<0.5)||(var.pig_vy<-0.0075&&var.pig_jump_t>0.174),0,var.pig_jump)))",
     "var.pig_fall": "if(varb.pig_same_frame,var.pig_fall,if(var.pig_air>0.5&&var.pig_vy<-0.025,1,if(is_in_water||var.pig_vy>=-0.0075||(is_on_ground&&var.pig_ground_confident>0.5),0,var.pig_fall)))",
     "var.pig_jump_warm": "if(varb.pig_same_frame,var.pig_jump_warm,clamp(var.pig_jump_warm+if(var.pig_jump>0.5,3.333333,-3.333333)*frame_time,0,1))",
     "var.pig_fall_warm": "if(varb.pig_same_frame,var.pig_fall_warm,clamp(var.pig_fall_warm+if(var.pig_fall>0.5,4.545455,-4.545455)*frame_time,0,1))",
     "var.pig_jump_blend": "var.pig_jump_warm*var.pig_jump_warm*(3-2*var.pig_jump_warm)",
     "var.pig_fall_blend": "var.pig_fall_warm*var.pig_fall_warm*(3-2*var.pig_fall_warm)",
     "var.pig_air_pose_blend": "max(var.pig_jump_blend,var.pig_fall_blend)",
     "var.pig_jump_t": "if(varb.pig_same_frame,var.pig_jump_t,if(var.pig_jump>0.5,min(var.pig_jump_t+frame_time,0.7667),if(var.pig_jump_warm<0.001,0,var.pig_jump_t)))",
     "var.pig_fall_t": "if(varb.pig_same_frame,var.pig_fall_t,if(var.pig_fall>0.5,min(var.pig_fall_t+frame_time,1),if(var.pig_fall_warm<0.001,0,var.pig_fall_t)))",
     "var.pig_bounce_vertical_edge": "if(var.pig_env_anchor_sampled>0.5&&abs(pos_y-var.pig_env_anchor_y)>=0.75&&!is_in_water&&!is_riding&&var.pig_rest<0.5,1,0)",
     "var.pig_bounce_confirm_t": "if(varb.pig_same_frame,var.pig_bounce_confirm_t,if(var.pig_bounce_armed>0.5&&is_on_ground&&var.pig_step_up_active<0.5&&var.pig_bounce_active<0.5,min(var.pig_bounce_confirm_t+frame_time,0.14),0))",
