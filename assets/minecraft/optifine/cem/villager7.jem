   "animations": [
    {
     "varb.fcc": "frame_counter == var.fcp",
     "var.vill_turn_raw_yaw": "todeg(rot_y)",
     "var.vill_turn_raw_delta": "if(var.vill_turn_sampled>0.5,wrapdeg(var.vill_turn_raw_yaw-var.vill_turn_anchor_yaw),0)",
     "var.vill_turn_delta": "clamp(var.vill_turn_raw_delta,-45,45)",
     "var.vill_turn_pose_gate": "if(is_on_ground,1,0)*clamp(1-limb_speed*4,0,1)",
     "var.vill_turn_pending": "if(var.vill_turn_pose_gate>0.5&&var.vill_turn_active<0.5&&abs(var.vill_turn_delta)>1.5,1,0)",
     "var.vill_turn_lead_t": "if(varb.fcc,var.vill_turn_lead_t,if(var.vill_turn_pending>0.5,var.vill_turn_lead_t+frame_time,0))",
     "var.vill_turn_start": "if(varb.fcc,0,if(var.vill_turn_pending>0.5&&(var.vill_turn_lead_t>=0.12||abs(var.vill_turn_delta)>=18),1,0))",
     "var.vill_turn_cycle_end": "if(varb.fcc,0,if(var.vill_turn_active>0.5&&var.vill_turn_t>=9.999,1,0))",
     "var.vill_turn_next_amount": "clamp(wrapdeg(var.vill_turn_raw_yaw-(var.vill_turn_anchor_yaw+var.vill_turn_amount)),-45,45)",
     "var.vill_turn_repeat_needed": "if(var.vill_turn_active>0.5&&abs(wrapdeg(var.vill_turn_raw_yaw-(var.vill_turn_anchor_yaw+var.vill_turn_amount)))>0.5,1,0)",
     "var.vill_turn_repeat": "if(var.vill_turn_cycle_end>0.5&&var.vill_turn_repeat_needed>0.5&&var.vill_turn_pose_gate>0.5,1,0)",
     "var.vill_turn_done": "if(var.vill_turn_cycle_end>0.5&&var.vill_turn_repeat<0.5&&var.vill_turn_pose_gate>0.5,1,0)",
     "var.vill_turn_anchor_yaw": "if(varb.fcc,var.vill_turn_anchor_yaw,if(var.vill_turn_sampled<0.5,var.vill_turn_raw_yaw,if(var.vill_turn_pose_gate<0.5,var.vill_turn_raw_yaw,if(var.vill_turn_cycle_end>0.5,var.vill_turn_anchor_yaw+var.vill_turn_amount,if(var.vill_turn_active<0.5&&var.vill_turn_pending<0.5,var.vill_turn_raw_yaw,var.vill_turn_anchor_yaw)))))",
     "var.vill_turn_t": "if(varb.fcc,var.vill_turn_t,if(var.vill_turn_pose_gate<0.5,0,if(var.vill_turn_start>0.5||var.vill_turn_cycle_end>0.5,0,if(var.vill_turn_active>0.5,min(var.vill_turn_t+frame_time*20,10),0))))",
     "var.vill_turn_active": "if(varb.fcc,var.vill_turn_active,if(var.vill_turn_pose_gate<0.5,0,if(var.vill_turn_start>0.5,1,if(var.vill_turn_cycle_end>0.5,var.vill_turn_repeat,var.vill_turn_active))))",
     "var.vill_turn_amount": "if(varb.fcc,var.vill_turn_amount,if(var.vill_turn_start>0.5,var.vill_turn_delta,if(var.vill_turn_repeat>0.5,var.vill_turn_next_amount,var.vill_turn_amount)))",
     "var.vill_turn_ease": "clamp(var.vill_turn_t/10,0,1)*clamp(var.vill_turn_t/10,0,1)*(3-2*clamp(var.vill_turn_t/10,0,1))",
     "var.vill_turn_seam_u": "clamp((var.vill_turn_t-8)/2,0,1)",
     "var.vill_turn_seam": "var.vill_turn_seam_u*var.vill_turn_seam_u*(3-2*var.vill_turn_seam_u)",
     "var.vill_turn_body_offset": "var.vill_turn_pose_gate*if(var.vill_turn_active>0.5,wrapdeg(var.vill_turn_anchor_yaw+var.vill_turn_amount*var.vill_turn_ease-var.vill_turn_raw_yaw),if(var.vill_turn_pending>0.5,-var.vill_turn_raw_delta,0))",
