   "animations": [
    {
     "varb.fcc": "frame_counter == var.fcp",
     "var.hy": "clamp(head_yaw,-90,90)",
     "var.aoff": "floor(random(id*4111)*1597)",
     "var.fw": "clamp(if(varb.fcc, var.fw, limb_speed>0.1, min(1,var.fw+0.14*frame_time*20), max(0,var.fw-0.11*frame_time*20)),0,1)",
     "var.aggro": "clamp(if(varb.fcc, var.aggro, is_aggressive, min(1,var.aggro+0.1*frame_time*20), max(0,var.aggro-0.1*frame_time*20)),0,1)",
     "var.gflower": "clamp(if(varb.fcc, var.gflower, right_arm.rx<-0.45 && left_arm.rx<-0.45 && var.aggro<0.3, min(1,var.gflower+0.14*frame_time*20), max(0,var.gflower-0.14*frame_time*20)),0,1)",
     "var.atkstart": "if(varb.fcc, var.atkstart, var.atkg<0.5 && right_arm.rx<-1.5, age, var.atkstart)",
     "var.atkside": "if(varb.fcc, var.atkside, var.atkg<0.5 && right_arm.rx<-1.5, 1-var.atkside, var.atkside)",
     "var.atkg": "clamp(if(varb.fcc, var.atkg, right_arm.rx<-1.5, 1, max(0,var.atkg-0.03*frame_time*20)),0,1)",
     "var.fallstart": "if(varb.fcc, var.fallstart, is_on_ground, age, var.fallstart)",
     "var.airlen": "if(varb.fcc, var.airlen, is_on_ground, var.airlen, age-var.fallstart)",
     "var.landt": "if(varb.fcc, var.landt, is_on_ground, var.landt, age)",
     "var.ffall": "clamp(if(varb.fcc, var.ffall, (age-var.fallstart)>2 && height_above_ground>1.2 && fluid_depth<0.05 && var.vy<0.1, min(1,var.ffall+0.4*frame_time*20), max(0,var.ffall-0.4*frame_time*20)),0,1)",
     "var.vy": "if(varb.fcc, var.vy, (pos_y-var.pyprev)*0.5 + var.vy*0.5)",
     "var.pyprev": "if(varb.fcc, var.pyprev, pos_y)",
     "var.jump": "clamp(if(varb.fcc, var.jump, var.vy>0.12 && height_above_ground>0.4 && fluid_depth<0.05, min(1,var.jump+0.35*frame_time*20), max(0,var.jump-0.25*frame_time*20)),0,1)",
     "var.turn": "if(varb.fcc, var.turn, clamp(degdiff(rot_y, var.roty),-8,8)*0.35 + var.turn*0.65)",
     "var.tsh": "if(varb.fcc, var.tsh, clamp(degdiff(rot_y, var.roty),-15,15)*0.45 + var.tsh*0.55)",
