   "animations": [
    {
     "varb.ci_same": "frame_counter==var.ci_fc",
     "var.cblink_start": "if(varb.ci_same,0,if(var.cblink_started<0.5||(var.cblink_active<0.5&&var.cblink_wait_t>=var.cblink_delay),1,0))",
     "var.cblink_seq": "if(varb.ci_same,var.cblink_seq,var.cblink_seq+var.cblink_start)",
     "var.cblink_delay": "if(varb.ci_same,var.cblink_delay,if(var.cblink_start>0.5,1+random(id*6841+var.cblink_seq*11003+290003)*2.75,var.cblink_delay))",
     "var.cblink_active": "if(varb.ci_same,var.cblink_active,if(var.cblink_start>0.5,1,if(var.cblink_active>0.5&&var.cblink_t<0.15,1,0)))",
     "var.cblink_t": "if(varb.ci_same,var.cblink_t,if(var.cblink_start>0.5,0,if(var.cblink_active>0.5,min(var.cblink_t+frame_time,0.15),var.cblink_t)))",
     "var.cblink_wait_t": "if(varb.ci_same,var.cblink_wait_t,if(var.cblink_start>0.5||var.cblink_active>0.5,0,var.cblink_wait_t+frame_time))",
     "var.cblink_started": "if(varb.ci_same,var.cblink_started,1)",
     "var.ci_start": "if(var.ci_state<0.5&&var.ci_time>3&&limb_speed<0.1&&!is_in_water,1,0)",
     "var.ci_len": "if(var.ci_sel<0.5,2.3333,if(var.ci_sel<1.5,2.625,2.7917))",
     "var.ci_end": "if(var.ci_state>0.5&&(var.ci_time>=var.ci_len||(var.ci_sel<0.5&&limb_speed>0.1)),1,0)",
     "var.ci_trans": "if(var.ci_start>0.5||var.ci_end>0.5,1,0)",
     "var.ci_seq": "var.ci_seq+var.ci_start",
     "var.ci_pick": "if(var.ci_start>0.5,random(id*5171+var.ci_seq*9973),var.ci_pick)",
     "var.ci_sel": "if(var.ci_start>0.5,floor(var.ci_pick*2.9999),var.ci_sel)",
     "var.ci_state": "if(var.ci_start>0.5,1,if(var.ci_end>0.5,0,var.ci_state))",
     "var.ci_time": "if(varb.ci_same,var.ci_time,if(var.ci_trans>0.5,0,var.ci_time+frame_time))",
     "var.ci_gate": "if(varb.ci_same,var.ci_gate,clamp(var.ci_gate+if(var.ci_state>0.5,1,-1)*frame_time/0.35,0,1))",
     "var.ci_frame": "if(var.ci_state>0.5,clamp(var.ci_time*24,0,if(var.ci_sel<0.5,56,if(var.ci_sel<1.5,63,67))),if(var.ci_sel<0.5,56,if(var.ci_sel<1.5,63,67)))",
     "var.ci_run": "if(varb.ci_same,var.ci_run,clamp(var.ci_run+if(limb_speed>0.85&&is_on_ground,1,-1)*frame_time/0.2,0,1))",
     "var.ci_air": "if(varb.ci_same,var.ci_air,clamp(var.ci_air+if(!is_on_ground&&!is_in_water,frame_time/0.15,-frame_time/0.4),0,1))",
