   "animations": [
    {
     "varb.frog_same": "frame_counter==var.frog_fc",
     "var.frog_blink_start": "if(varb.frog_same,0,if(var.frog_blink_active<0.5&&var.frog_blink_wait_t>=if(var.frog_blink_started<0.5,0.2+random(id*6841+310003)*3.6,var.frog_blink_delay),1,0))",
     "var.frog_blink_seq": "if(varb.frog_same,var.frog_blink_seq,var.frog_blink_seq+var.frog_blink_start)",
     "var.frog_blink_alt": "var.frog_blink_seq-floor(var.frog_blink_seq/2)*2",
     "var.frog_blink_delay": "if(varb.frog_same,var.frog_blink_delay,if(var.frog_blink_start>0.5,0.2+random(id*6841+var.frog_blink_seq*11003+310003)*3.6,var.frog_blink_delay))",
     "var.frog_blink_active": "if(varb.frog_same,var.frog_blink_active,if(var.frog_blink_start>0.5,1,if(var.frog_blink_active>0.5&&var.frog_blink_t<0.3333,1,0)))",
     "var.frog_blink_t": "if(varb.frog_same,var.frog_blink_t,if(var.frog_blink_start>0.5,0,if(var.frog_blink_active>0.5,min(var.frog_blink_t+frame_time,0.3333),var.frog_blink_t)))",
     "var.frog_blink_i": "floor(var.frog_blink_t*24)",
     "var.frog_blink_f": "frac(var.frog_blink_t*24)",
     "var.frog_blink_wait_t": "if(varb.frog_same,var.frog_blink_wait_t,if(var.frog_blink_start>0.5||var.frog_blink_active>0.5,0,var.frog_blink_wait_t+frame_time))",
     "var.frog_blink_started": "if(varb.frog_same,var.frog_blink_started,if(var.frog_blink_start>0.5,1,var.frog_blink_started))",
     "var.frog_eat_raw": "if(tongue.sz>1.01||abs(tongue.rx)>torad(0.5),1,0)",
     "var.frog_eat_start": "if(varb.frog_same,0,if(var.frog_eat_raw>0.5&&var.frog_eat_prev<0.5,1,0))",
     "var.frog_eat_active": "if(varb.frog_same,var.frog_eat_active,if(var.frog_eat_start>0.5,1,if(var.frog_eat_active>0.5&&var.frog_eat_t<1.0833,1,0)))",
     "var.frog_eat_t": "if(varb.frog_same,var.frog_eat_t,if(var.frog_eat_start>0.5,0,if(var.frog_eat_active>0.5,min(var.frog_eat_t+frame_time,1.0833),var.frog_eat_t)))",
     "var.frog_eat_prev": "if(varb.frog_same,var.frog_eat_prev,var.frog_eat_raw)",
     "var.frog_eat_i": "floor(var.frog_eat_t*24)",
     "var.frog_eat_f": "frac(var.frog_eat_t*24)",
     "var.frog_croak_raw": "if(croaking_body.visible,1,0)",
     "var.frog_croak_start": "if(varb.frog_same,0,if(var.frog_croak_raw>0.5&&var.frog_croak_prev<0.5,1,0))",
     "var.frog_croak_t": "if(varb.frog_same,var.frog_croak_t,if(var.frog_croak_start>0.5,0,if(var.frog_croak_raw>0.5,min(var.frog_croak_t+frame_time,3),0)))",
     "var.frog_croak_prev": "if(varb.frog_same,var.frog_croak_prev,var.frog_croak_raw)",
     "var.frog_croak_i": "floor(var.frog_croak_t*24)",
     "var.frog_croak_f": "frac(var.frog_croak_t*24)",
     "var.frog_vy": "if(varb.frog_same,var.frog_vy,pos_y-var.frog_py_prev)",
     "var.frog_py_prev": "if(varb.frog_same,var.frog_py_prev,pos_y)",
     "var.frog_rise": "if(varb.frog_same,var.frog_rise,clamp(var.frog_rise+if(!is_on_ground&&var.frog_vy>0.01,1,-1)*frame_time/0.08,0,1))",
     "var.frog_fall": "if(varb.frog_same,var.frog_fall,clamp(var.frog_fall+if(!is_on_ground&&var.frog_vy<-0.01,1,-1)*frame_time/0.08,0,1))",
     "var.frog_land": "if(is_on_ground&&var.frog_air_prev>0.5,1,0)",
     "var.frog_bounce_t": "if(varb.frog_same,var.frog_bounce_t,if(var.frog_land>0.5,0,min(var.frog_bounce_t+frame_time,0.625)))",
     "var.frog_air_prev": "if(varb.frog_same,var.frog_air_prev,if(is_on_ground,0,1))",
     "var.frog_swim_go": "if(varb.frog_same,var.frog_swim_go,if(is_in_water,1,if(is_on_ground,0,var.frog_swim_go)))",
