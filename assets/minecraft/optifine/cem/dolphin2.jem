   "animations": [
    {
     "var.dolphin_beached": "if(is_in_water,0,1)",
     "var.dolphin_swim_t": "if(var.dolphin_beached<0.5,var.dolphin_swim_t+frame_time,0)",
     "var.dolphin_swim_warm": "clamp(var.dolphin_swim_warm+if(var.dolphin_beached<0.5,5,-5)*frame_time,0,1)",
     "var.dolphin_beach_t": "if(var.dolphin_beached>0.5,var.dolphin_beach_t+frame_time,0)",
     "var.dolphin_beach_warm": "clamp(var.dolphin_beach_warm+if(var.dolphin_beached>0.5,5,-5)*frame_time,0,1)",
     "var.dolphin_blink": "if((age+random(id)*34)-floor((age+random(id)*34)/34)*34<3,1,0)",
     "alt_dolphin.sx": "0.5",
     "alt_dolphin.sy": "0.5",
     "alt_dolphin.sz": "0.5",
     "alt_body.rx": "torad(-cos(torad(var.dolphin_swim_t*300))*6)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_swim_t*120))*2.5)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_head.rx": "torad(sin(torad(var.dolphin_swim_t*300))*10)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(clamp(head_pitch*0.35,-15,15))*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_left_fin.ry": "torad(-25)+torad(-cos(torad(var.dolphin_swim_t*300))*12)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_left_fin.rz": "torad(20)+torad(cos(torad(var.dolphin_swim_t*300))*12)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(-sin(torad(var.dolphin_swim_t*120))*5)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_beach_t*300-45))*90)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_right_fin.ry": "torad(25)+torad(cos(torad(var.dolphin_swim_t*300))*12)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_right_fin.rz": "torad(-20)+torad(-cos(torad(var.dolphin_swim_t*300))*12)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_swim_t*120))*5)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_beach_t*300-45))*90)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_tail.rx": "torad(-cos(torad(var.dolphin_swim_t*300))*6)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_swim_t*120))*2.5)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(-cos(torad(var.dolphin_beach_t*600-45))*30)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_tail_fin.rx": "torad(-cos(torad(var.dolphin_swim_t*300-45))*12)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_swim_t*120-45))*5)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(-sin(torad(var.dolphin_beach_t*600))*30)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_body.rz": "torad(cos(torad(var.dolphin_swim_t*60))*4)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+torad(sin(torad(var.dolphin_beach_t*300))*90)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_tail.ry": "torad(cos(torad(var.dolphin_swim_t*60))*3)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_tail.rz": "torad(-sin(torad(var.dolphin_swim_t*60))*3)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_head.ry": "torad(clamp(head_yaw*0.35,-25,25))*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))",
     "alt_back_fin.rz": "torad(sin(torad(var.dolphin_beach_t*300-45))*60)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_tail_fin.rz": "torad(sin(torad(var.dolphin_beach_t*300-45))*30)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm))",
     "alt_body.ty": "-3+-1*((sin(torad(var.dolphin_swim_t*300+22.5))*1)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+(cos(torad(var.dolphin_swim_t*120))*0.4)*(var.dolphin_swim_warm*var.dolphin_swim_warm*(3-2*var.dolphin_swim_warm))+(-2)*(var.dolphin_beach_warm*var.dolphin_beach_warm*(3-2*var.dolphin_beach_warm)))",
     "face.sx": "1-var.dolphin_blink",
     "blink.sx": "1.01*var.dolphin_blink",
     "face.sy": "1-var.dolphin_blink",
     "blink.sy": "1.01*var.dolphin_blink",
     "face.sz": "1-var.dolphin_blink",
     "blink.sz": "1.01*var.dolphin_blink"
    }
   ]
