   "animations": [
    {
     "varb.fcc": "frame_counter == var.fcp",
     "var.count_sleep": "clamp(if(varb.fcc, var.count_sleep, min(1, var.count_sleep+0.06*frame_time*20)),0,1)",
     "var.sleep_t": "clamp(if(varb.fcc, var.sleep_t, min(40, var.sleep_t+frame_time*20)),0,40)",
     "var.stoff": "random(id*7919)*400",
     "brows.sy": "keyframe(var.sleep_t,0.7,0.9678,1.3643,1.7541,2.002,1.9722,1.7025,1.4443,1.4146,1.5144,1.6712,1.8405,1.9775,2.02,2.02,2.02,2.02,2.02,2.02,2.02,2.02,2.02,2.02,2.02,2.02)",
     "alt_body.rx": "torad(sin((age+var.stoff)*0.1309)*1.5)*var.count_sleep",
     "alt_head.rx": "torad(keyframe(var.sleep_t,0,0,-0.7482,-4.9781,-6.5152,2.009,15.5381,19.6814,13.3885,4.5074,0,2.9014,9.7169,17.613,25.7959,36.5625,44.4017,43.1277,29.8732,12.3942,0,-3.3074,-2.1609,-0.2032,0)) + torad(-sin((age+var.stoff)*0.1309)*1.5)*var.count_sleep",
